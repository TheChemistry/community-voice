{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE"
  },
  "services": [
    {
      "name": "web",
      "sourceDir": "apps/web",
      "buildCommand": "npm run build",
      "startCommand": "node server.js"
    },
    {
      "name": "api",
      "sourceDir": "apps/api",
      "buildCommand": "npm run build",
      "startCommand": "node dist/main.js"
    }
  ]
}
