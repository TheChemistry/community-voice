datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

enum Role {
  CITIZEN
  MODERATOR
  MUNICIPAL_ADMIN
  SUPER_ADMIN
}

enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  FLAGGED
  ACCEPTED
  ACKNOWLEDGED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  VERIFIED_RESOLVED
  REJECTED
  CLOSED
}

enum ModerationAction {
  APPROVE
  REJECT
  ESCALATE
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String? // Nullable if using OIDC/OAuth
  firstName        String?
  lastName         String?
  role             Role             @default(CITIZEN)
  isActive         Boolean          @default(true)
  isPiiRedacted    Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  accounts         Account[]
  sessions         Session[]
  reports          CivicReport[]
  comments         Comment[]
  votes            Vote[]
  surveyResponses  SurveyResponse[]
  auditLogs        AuditLog[]
  watchedReports   Watchlist[]
  verifications    ResolutionVerification[]
  govResponses     GovernmentResponse[]
  createdTaskForces TaskForce[]     @relation("CreatedTaskForces")
  volunteeredAt    Volunteer[]

  @@index([email])
  @@index([role])
}

model Account {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CivicReport {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  description    String
  category       String
  department     String?          // e.g., "Public Works", "Parks"
  status         ReportStatus     @default(SUBMITTED)
  priorityScore  Float            @default(0.0)

  // AI Insights
  aiSummary      String?          @db.Text
  aiTimeline     Json?            // Event-based timeline
  aiTrendTags    String[]         // Tags for trend detection

  // Lifecycle Timestamps
  acknowledgedAt DateTime?
  assignedAt     DateTime?
  inProgressAt   DateTime?
  resolvedAt     DateTime?
  verifiedAt     DateTime?
  closedAt       DateTime?

  // Geospatial data
  latitude       Float
  longitude      Float

  attachments    MediaAttachment[]
  comments       Comment[]
  votes          Vote[]
  moderationLogs ModerationQueue[]
  responses      GovernmentResponse[]
  watchers       Watchlist[]
  verifications  ResolutionVerification[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([category])
  @@index([userId])
  @@index([department])
}

model GovernmentResponse {
  id             String       @id @default(uuid())
  reportId       String
  report         CivicReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  officialId     String
  official       User         @relation(fields: [officialId], references: [id], onDelete: Cascade)
  content        String       @db.Text
  statusChange   ReportStatus?
  attachments    Json?        // S3 keys for official updates/evidence
  createdAt      DateTime     @default(now())

  @@index([reportId])
  @@index([officialId])
}

model Watchlist {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportId  String
  report    CivicReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([userId, reportId])
}

model ResolutionVerification {
  id             String       @id @default(uuid())
  reportId       String
  report         CivicReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  beforePhotoKey String
  afterPhotoKey  String
  aiConfidence   Float        @default(0.0)
  isVerified     Boolean      @default(false)
  comment        String?      @db.Text
  createdAt      DateTime     @default(now())

  @@index([reportId])
}

model TaskForce {
  id            String      @id @default(uuid())
  title         String
  description   String
  category      String
  location      String?
  scheduledAt   DateTime?
  creatorId     String
  creator       User        @relation("CreatedTaskForces", fields: [creatorId], references: [id])
  volunteers    Volunteer[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Volunteer {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskForceId String
  taskForce   TaskForce @relation(fields: [taskForceId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())

  @@unique([userId, taskForceId])
}

model MediaAttachment {
  id              String       @id @default(uuid())
  reportId        String?
  report          CivicReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)
  s3Key           String
  url             String
  redactedUrl     String?      // URL to the version with blurred faces/plates
  mimeType        String
  fileSize        Int
  aiTranscription String?      @db.Text
  aiAnalysis      Json?        // Detailed AI detection results (movement, vehicles, etc.)
  isFlagged       Boolean      @default(false)
  createdAt       DateTime     @default(now())

  @@index([reportId])
}

model Comment {
  id         String       @id @default(uuid())
  reportId   String
  report     CivicReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String       @db.Text
  isReported Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([reportId])
  @@index([userId])
}

model Vote {
  id         String       @id @default(uuid())
  reportId   String
  report     CivicReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction  Int          // 1 for Upvote, -1 for Downvote
  createdAt  DateTime     @default(now())

  @@unique([userId, reportId])
  @@index([reportId])
}

model ModerationQueue {
  id             String            @id @default(uuid())
  reportId       String
  report         CivicReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  aiFlagged      Boolean           @default(false)
  aiConfidence   Float             @default(0.0)
  aiReasoning    String?           @db.Text
  aiRiskCategory String?           // e.g., "Harassment", "Defamation"
  assignedToRole Role              @default(MODERATOR)
  actionTaken    String?
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())

  @@index([aiFlagged])
  @@index([reportId])
}

model Survey {
  id             String           @id @default(uuid())
  title          String
  description    String
  schemaJson     Json             // Defines dynamic fields, validation, conditions
  isActive       Boolean          @default(true)
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  responses      SurveyResponse[]
}

model SurveyResponse {
  id         String   @id @default(uuid())
  surveyId   String
  survey     Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId     String?  // Nullable for anonymous participation
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers    Json     // Key-value store of responses matching dynamic schema
  submittedAt DateTime @default(now())

  @@index([surveyId])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   Json
  ipAddress String
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}
